  "texts": [
    {
      "id": "maria",
      "title": "Maria",
      "sv": "Maria",
      "nota": "Två små verb bär nästan allt: è (är) och ha (har).",
      "level": 1,
      "narrator": "f",
      "sentences": [
        {
          "it": "Maria è italiana.",
          "sv": "Maria är italienska."
        },
        {
          "it": "Ha una casa a Roma.",
          "sv": "Hon har ett hus i Rom."
        },
        {
          "it": "La casa è piccola ma bella.",
          "sv": "Huset är litet men fint."
        },
        {
          "it": "Maria ha anche un cane.",
          "sv": "Maria har också en hund."
        },
        {
          "it": "Il cane è grande e non è tranquillo!",
          "sv": "Hunden är stor och är inte lugn!"
        }
      ],
      "question": {
        "sv": "Hur är Marias hus?",
        "options": ["Litet men fint", "Stort och lugnt", "Gammalt och dyrt"],
        "answer": 0
      }
    },
    {
      "id": "al-bar",
      "title": "Al bar",
      "sv": "På kaféet",
      "nota": "Ändelsen visar vem: prende = han tar, parlano = de pratar.",
      "level": 1,
      "narrator": "f",
      "sentences": [
        {
          "it": "Marco è al bar con un amico.",
          "sv": "Marco är på kaféet med en vän."
        },
        {
          "it": "Marco prende un caffè e l'amico prende un tè.",
          "sv": "Marco tar en kaffe och vännen tar en te."
        },
        {
          "it": "«Il caffè è buono?» «Sì, molto buono!»",
          "sv": "”Är kaffet gott?” ”Ja, mycket gott!”",
          "speakers": ["m", "m"]
        },
        {
          "it": "Il bar è piccolo, ma c'è sempre molta gente.",
          "sv": "Kaféet är litet, men där är alltid mycket folk."
        },
        {
          "it": "Marco e l'amico parlano di musica.",
          "sv": "Marco och vännen pratar om musik."
        }
      ],
      "question": {
        "sv": "Vad pratar Marco och vännen om?",
        "options": ["Musik", "Kaffe", "Arbete"],
        "answer": 0
      }
    },
    {
      "id": "alla-stazione",
      "title": "Alla stazione",
      "sv": "På stationen",
      "nota": "Ord på -zione kan du redan: station → stazione.",
      "level": 2,
      "narrator": "m",
      "sentences": [
        {
          "it": "La stazione centrale di Milano è molto grande.",
          "sv": "Centralstationen i Milano är mycket stor."
        },
        {
          "it": "Ci sono molti treni e molte persone.",
          "sv": "Där finns många tåg och många människor."
        },
        {
          "it": "Una donna cerca informazioni: «Dov'è il treno per Roma?»",
          "sv": "En kvinna söker information: ”Var är tåget till Rom?”",
          "speakers": ["f"]
        },
        {
          "it": "Un uomo risponde: «È qui, ma oggi è in ritardo.»",
          "sv": "En man svarar: ”Det är här, men i dag är det försenat.”",
          "speakers": ["m"]
        },
        {
          "it": "«Che situazione!» dice la donna.",
          "sv": "”Vilken situation!” säger kvinnan.",
          "speakers": ["f"]
        },
        {
          "it": "«È normale», dice l'uomo.",
          "sv": "”Det är normalt”, säger mannen.",
          "speakers": ["m"]
        }
      ],
      "question": {
        "sv": "Vad är det med tåget till Rom?",
        "options": ["Det är försenat", "Det är inställt", "Det har redan gått"],
        "answer": 0
      }
    },
    {
      "id": "firenze",
      "title": "Firenze",
      "sv": "Florens",
      "nota": "Fler gratisord: city → città, famous → famoso, incredible → incredibile.",
      "level": 2,
      "narrator": "m",
      "sentences": [
        {
          "it": "Firenze è una città famosa.",
          "sv": "Florens är en berömd stad."
        },
        {
          "it": "Il centro storico è piccolo ma incredibile.",
          "sv": "Den historiska stadskärnan är liten men otrolig."
        },
        {
          "it": "Ci sono musei, università e ristoranti tipici.",
          "sv": "Där finns museer, universitet och typiska restauranger."
        },
        {
          "it": "I turisti arrivano da tutto il mondo.",
          "sv": "Turisterna kommer från hela världen."
        },
        {
          "it": "In estate fa molto caldo e ci sono troppi turisti.",
          "sv": "På sommaren är det mycket varmt och det är för många turister."
        },
        {
          "it": "Ma la città è sempre bella.",
          "sv": "Men staden är alltid vacker."
        }
      ],
      "question": {
        "sv": "Hur är Florens på sommaren?",
        "options": ["Varmt och fullt av turister", "Kallt och tomt", "Lugnt och svalt"],
        "answer": 0
      }
    },
    {
      "id": "la-mia-famiglia",
      "title": "La mia famiglia",
      "sv": "Min familj",
      "nota": "-iamo betyder alltid vi: mangiamo = vi äter.",
      "level": 2,
      "narrator": "f",
      "sentences": [
